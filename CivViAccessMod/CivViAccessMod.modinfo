<?xml version="1.0" encoding="utf-8"?>
<Mod id="49224623-c629-4e7a-a5cb-ad822828072e" version="1">
  <Properties>
    <Name>Screen Reader Access</Name>
    <Teaser>A mod that allows textual information from game to be output via a running screen reader, allowing blind and visually impaired</Teaser>
    <Description>A mod that allows textual information from game to be output via a running screen reader, allowing blind and visually impaired players to play the game.</Description>
    <Authors>Noel Romey</Authors>
    <SpecialThanks></SpecialThanks>
    <AffectsSavedGames>1</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <FrontEndActions>
    <ImportFiles id="SRAccess_FE_UpdateFiles">
      <File priority="10001">Assets/UI/ToolTips/PlotToolTip.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Log.lua</File>
      <File priority="10001">Assets/UI/Accessibility/HandlerStack.lua</File>
      <File priority="10001">Assets/UI/Accessibility/InputRouter.lua</File>
      <File priority="10001">Assets/UI/Accessibility/EngineHotkeys.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ScreenReader.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Verbosity.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Help.lua</File>
      <File priority="10001">Assets/UI/Accessibility/BaseMenu.lua</File>
      <File priority="10001">Assets/UI/Accessibility/BaseMenuItems.lua</File>
      <!-- MainMenuAccess + LoadGameMenuAccess both inlined into their
           respective forks (Assets/UI/Frontend/MainMenu.lua and
           Assets/UI/Frontend/LoadGameMenu.lua) to defeat Civ VI's
           include() process-wide cache. Bug #24 (MainMenuAccess on
           exit-to-main-menu) and bug #22 (LoadGameMenuAccess nil at
           every call site per Lua.log runtime errors). -->
      <File priority="10001">Assets/UI/Accessibility/OptionsAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/AdvancedSetupAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ScenarioSetupAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/MultiSelectWindowAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/CityStatePickerAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/LeaderPickerAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/LoadScreenAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ContextHelp.lua</File>
      <File priority="10001">Assets/UI/Panels/StatusMessagePanel.lua</File>
      <File priority="10001">Assets/UI/Panels/NotificationPanel.lua</File>
      <File priority="10001">Assets/UI/Frontend/MainMenu.lua</File>
      <File priority="10001">Assets/UI/Frontend/FrontEndPopup.lua</File>
      <File priority="10001">Assets/UI/Frontend/IntroScreen.lua</File>
      <File priority="10001">Assets/UI/Frontend/LoadGameMenu.lua</File>
      <File priority="10001">Assets/UI/Frontend/LoadScreen.lua</File>
      <File priority="10001">Assets/UI/Frontend/AdvancedSetup.lua</File>
      <File priority="10001">Assets/UI/Frontend/ScenarioSetup.lua</File>
      <File priority="10001">Assets/UI/Frontend/MultiSelectWindow.lua</File>
      <File priority="10001">Assets/UI/Frontend/CityStatePicker.lua</File>
      <File priority="10001">Assets/UI/Frontend/LeaderPicker.lua</File>
      <File priority="10001">Assets/UI/Options.lua</File>
    </ImportFiles>
    <UpdateText id="SRAccess_FE_Text">
      <File>Assets/Text/en_US/CivVIAccessStrings.xml</File>
      <File>Assets/Text/en_US/LeaderDescriptions.xml</File>
    </UpdateText>
    <UpdateDatabase id="SRAccess_FE_RemapForHexCursor">
      <File>Assets/Data/RemapForHexCursor.xml</File>
    </UpdateDatabase>
  </FrontEndActions>
  <InGameActions>
    <ImportFiles id="SRAccess_IG_UpdateFiles">
      <File priority="10001">Assets/UI/ToolTips/PlotToolTip.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Log.lua</File>
      <File priority="10001">Assets/UI/Accessibility/HandlerStack.lua</File>
      <File priority="10001">Assets/UI/Accessibility/InputRouter.lua</File>
      <File priority="10001">Assets/UI/Accessibility/EngineHotkeys.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ScreenReader.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ScreenReaderPlotUtils.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Help.lua</File>
      <File priority="10001">Assets/UI/Accessibility/RevealPopupAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ChoosePopupAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/PolicyWizard.lua</File>
      <File priority="10001">Assets/UI/Accessibility/HexGeom.lua</File>
      <File priority="10001">Assets/UI/Accessibility/HexCursor.lua</File>
      <File priority="10001">Assets/UI/Accessibility/UnitMovement.lua</File>
      <File priority="10001">Assets/UI/Accessibility/UnitInfo.lua</File>
      <File priority="10001">Assets/UI/Accessibility/CityProduction.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Notifications.lua</File>
      <File priority="10001">Assets/UI/Accessibility/BaseMenu.lua</File>
      <File priority="10001">Assets/UI/Accessibility/BaseMenuItems.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Verbosity.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Diagnostics.lua</File>
      <File priority="10001">Assets/UI/Accessibility/SuppressFirstTurnAdvisor.lua</File>
      <File priority="10001">Assets/UI/Additions/HexCursorAddin.lua</File>
      <File priority="10001">Assets/UI/Additions/ProductionPickerAddin.lua</File>
      <File priority="10001">Assets/UI/Additions/TechPickerAddin.lua</File>
      <File priority="10001">Assets/UI/Additions/CivicPickerAddin.lua</File>
      <File priority="10001">Assets/UI/Additions/HelpAddin.lua</File>
      <File priority="10001">Assets/UI/Additions/RevealListeners.lua</File>
      <File priority="10001">Assets/UI/Menus/InGameTopOptionsMenu.lua</File>
      <File priority="10001">Assets/UI/Panels/StatusMessagePanel.lua</File>
      <File priority="10001">Assets/UI/Panels/NotificationPanel.lua</File>
      <File priority="10001">Assets/UI/Panels/ProductionPanel.lua</File>
      <File priority="10001">Assets/UI/Popups/TechCivicCompletedPopup.lua</File>
      <File priority="10001">Assets/UI/Popups/NaturalWonderPopup.lua</File>
      <File priority="10001">Assets/UI/Popups/BoostUnlockedPopup.lua</File>
      <File priority="10001">Assets/UI/Popups/ProjectBuiltPopup.lua</File>
      <File priority="10001">Assets/UI/Popups/WonderBuiltPopup.lua</File>
      <!-- Group B: CHOICE popups (navigate + select), via ChoosePopupAccess.
           PantheonChooser is base-game + shadowable like the Group A popups. -->
      <File priority="10001">Assets/UI/Choosers/PantheonChooser.lua</File>
      <!-- HeroesPopup / SecretSocietyPopup / NaturalDisasterPopup /
           RockBandMoviePopup / EraCompletePopup are DLC-provided contexts we
           CANNOT shadow (user mods apply before the DLC creates them). We
           announce them via the RevealListeners addin (InGameActions) instead. -->
      <File priority="10001">Assets/UI/Accessibility/ScreenReaderPlotUtils.lua</File>
      <File priority="10001">Assets/UI/Accessibility/OptionsAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/AdvisorPopupAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ExpansionIntroAccess.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ContextHelp.lua</File>
      <File priority="10001">Assets/UI/Accessibility/TutorialAccess.lua</File>
      <File priority="10001">Assets/UI/Options.lua</File>
      <File priority="10001">Assets/UI/Popups/AdvisorPopup.lua</File>
      <File priority="10001">Assets/UI/Additions/ExpansionIntro.lua</File>
    </ImportFiles>
    <AddGameplayScripts id="SRAccess_IG_GameplayScripts">
      <File priority="10001">Assets/UI/Accessibility/Log.lua</File>
      <File priority="10001">Assets/UI/Accessibility/Diagnostics.lua</File>
      <!-- SuppressFirstTurnAdvisor disabled 2026-05-23 so the
           AdvisorPopupAccess wrapper can be tested. Re-enable as a
           safety net only if AdvisorPopupAccess proves unreliable.
           File still ships in <Files> so re-registering is one-line.
      <File priority="10001">Assets/UI/Accessibility/SuppressFirstTurnAdvisor.lua</File>
      -->
      <!-- Debug-only: reset tutorial seen-flags on every game start
           so tutorial popups (FIRST_GREETING, expansion intros,
           post-found-city advisor) actually fire during testing.
           Remove once tutorial flow is validated end-to-end.
           Internally has DISABLE_RESET flag for in-file toggle. -->
      <File priority="10001">Assets/UI/Accessibility/TutorialReset.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ScreenReaderEventHandlers.lua</File>
      <File priority="10001">Assets/UI/Accessibility/ScreenReaderPlotUtils.lua</File>
      <File priority="10001">Assets/UI/Accessibility/TurnAnnouncements.lua</File>
      <File priority="10001">Assets/UI/Accessibility/WorldInteractiveAnnounce.lua</File>
      <!-- Debug-only: manufacture a rock-band concert on demand
           (LuaEvents.CivViAccess_DebugGenerateConcert) to test the RockBand
           reveal gate. Gameplay VM (needs UnitManager.InitUnit*). Strip before release. -->
      <File priority="10001">Assets/UI/Accessibility/DebugConcert.lua</File>
      <!-- Notifications.lua deliberately NOT in AddGameplayScripts.
           Civ VI's gameplay + UI contexts are SEPARATE Lua VMs (each
           has its own globals table, its own Events subscriptions,
           and its own Notifications._initialized guard). Loading
           Notifications.lua in both VMs (via AddGameplayScripts AND
           via the addin's include) caused dual handler registration:
           the engine fired NotificationAdded once and BOTH VMs'
           handlers ran, each populating their own cache. Confirmed
           via Lua.log inspection 2026-05-25: same notification logged
           twice, once with "Notifications:" prefix (gameplay VM) and
           once with "HexCursorAddin:" prefix (UI VM). The UI VM is
           the one the cycle hotkey reads from, so we keep loading
           there via the addin's include() and skip AddGameplayScripts. -->
    </AddGameplayScripts>
    <AddUserInterfaces id="SRAccess_HexCursorAddin">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>Assets/UI/Additions/HexCursorAddin.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="SRAccess_ProductionPickerAddin">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>Assets/UI/Additions/ProductionPickerAddin.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="SRAccess_TechPickerAddin">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>Assets/UI/Additions/TechPickerAddin.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="SRAccess_CivicPickerAddin">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>Assets/UI/Additions/CivicPickerAddin.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="SRAccess_HelpAddin">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>Assets/UI/Additions/HelpAddin.xml</File>
    </AddUserInterfaces>
    <!-- The DLC reveal popups (Heroes / SecretSociety / NaturalDisaster /
         RockBand / EraComplete) CANNOT be shadowed: they're added by their
         expansion/mode pack as named UI Contexts, and user mods apply as a
         block BEFORE all official DLC (confirmed via Modding.log apply-order
         2026-05-29), so ReplaceUIScript / ImportFiles / LoadOrder can't win.
         Instead RevealListeners is a headless addin that subscribes to the
         same trigger events and announces; the vanilla popup still shows and
         handles its own dismiss. Loads in the early user-mod phase like the
         other addins, so no replacement / criteria / load-order tricks. -->
    <AddUserInterfaces id="SRAccess_RevealListeners">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>Assets/UI/Additions/RevealListeners.xml</File>
    </AddUserInterfaces>
    <UpdateText id="SRAccess_IG_Text">
      <File>Assets/Text/en_US/CivVIAccessStrings.xml</File>
      <File>Assets/Text/en_US/LeaderDescriptions.xml</File>
      <File>Assets/Text/en_US/NaturalWonderDescriptions.xml</File>
      <File>Assets/Text/en_US/WorldWonderDescriptions.xml</File>
      <File>Assets/Text/en_US/HeroDescriptions.xml</File>
      <File>Assets/Text/en_US/SecretSocietyDescriptions.xml</File>
    </UpdateText>
    <!-- RemapForHexCursor is intentionally only registered in
         FrontEndActions. InputActionDefaultGestures lives in the
         Configuration database; updates against the Gameplay database
         fail with "no such table". Confirmed 2026-05-22 via Database.log.
         The FrontEndActions UpdateDatabase above targets Configuration
         and is the only place this XML belongs. -->
  </InGameActions>
