    <Row ActionId="CIVVIACCESS_CursorNE" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_E"/>
    <Row ActionId="CIVVIACCESS_CursorW" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_A"/>
    <Row ActionId="CIVVIACCESS_CursorE" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_D"/>
    <Row ActionId="CIVVIACCESS_CursorSW" Index="0" GestureType="KBMouse"
