<?xml version="1.0" encoding="utf-8"?>
<!--
  Two-part XML driving CivViAccess's input layer:

  1. Move existing Civ VI engine actions OFF Q/E/A/Z/C to Alt+letter. Frees
     the bare letters for HexCursor. Sighted muscle memory preserved — same
     letter, hold Alt.

       Q  ToggleResources    -> Alt+Q
       E  AutoExplore        -> Alt+E
       A  Attack             -> Alt+A
       Z  Sleep              -> Alt+Z
       C  ToggleCivicsTree   -> Alt+C

  2. Register NEW engine actions (CIVVIACCESS_Cursor*) for HexCursor and
     coord keys. Bind each to its primary key + numpad alternate where
     applicable. Pressing one fires Events.InputActionTriggered with that
     action's ID; HexCursorAddin.lua subscribes and dispatches. This is
     the route used by the engine itself for ALL hotkeys; AddUserInterfaces
     Contexts don't get raw keyboard (confirmed empirically).

  Why this is acceptable per [[feedback-runtime-toggle-over-install-choice]]:
  the rebind is consistent (same letter + Alt modifier), discoverable (in
  the ? help overlay), reversible (user can remap via Civ VI Options >
  Keybindings).

  Numpad alternates were dropped 0.5.0. Two unfixable conflicts:
  NVDA's default "Use numpad keys for object navigation" intercepts
  the numpad before Civ VI sees it, AND Alt+numpad on Windows is the
  Unicode-input gesture (Alt+0233 = é etc.) which collides with the
  Alt+QAZEDC move bindings. Civ V Access and other accessibility mods
  converged on letter-cluster-only nav for these same reasons; we're
  catching up. Letter keys (Q/E/A/D/Z/C) are the only nav surface.

  Two-modifier letter cluster (0.5.0, revised after test failure):

    Bare        Q/E/A/D/Z/C   → HexCursor move (read terrain, don't commit)
    Shift+      Shift+QAZEDC  → Unit direct-move (commit a move)
    Alt+letter  Alt+QAZEDC    → Engine actions (ToggleResources etc.)

  Originally tried Alt+letter for Move + Ctrl+Alt+letter for the engine
  actions, but the 3-key Update statement for the engine rebind silently
  failed in test — Civ VI's vanilla InputConfiguration.xml never uses
  3-key combos and the gesture parser doesn't appear to support them.
  Result: engine actions stayed on Alt+letter (from 0.4.x), our Move
  bindings on Alt+letter collided silently, and no movement fired. Shift+
  letter avoids the conflict entirely AND isn't intercepted by NVDA/JAWS
  (Shift is a typing modifier, not screen-reader-claimed).
-->
<GameInfo>
  <!-- ===================================================================
       Part 1: rebind engine actions off bare letters (frees Q/E/A/Z/C
       for HexCursor cursor pan). Engine actions land on Alt+letter, same
       as the 0.4.x state. Our Move bindings live on Shift+letter (no
       collision).
       =================================================================== -->
  <InputActionDefaultGestures>
    <Update>
      <Where ActionId="ToggleResources" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_Q</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="AutoExplore" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_E</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="Attack" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_A</GestureData>
      </Set>
    </Update>
    <!-- Engine ActionId="Sleep" is wired to UNITOPERATION_SLEEP via
         HotkeyId="Sleep" in UnitOperations.xml; that data-driven
         dispatch path doesn't honor mod XML rebinds for existing
         engine actions (diagnostic 2026-05-26: bare-J test fired no
         action id 53 in Lua.log even with a unit selected). Engine
         Sleep is left on default key Z, which is taken by our
         CursorSW rebind — so engine Sleep is effectively unbound.
         Our working path: CIVVIACCESS_Rest (R, smart cascade) and
         CIVVIACCESS_Sleep (Alt+Z, strict-with-educational-redirect).
         See InputActions block. -->
    <Update>
      <Where ActionId="ToggleCivicsTree" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_C</GestureData>
      </Set>
    </Update>
    <!-- T and R don't collide with the move bindings; keeping them on
         Alt+letter (set in 0.4.1) for now. Briefing re-read actions
         (CIVVIACCESS_AbilitiesReread on T, CIVVIACCESS_PortraitDescribe
         on I, CIVVIACCESS_DawnOfManTranscript on S, CIVVIACCESS_Repeat
         Briefing on R) use the bare letters, registered below. -->
    <Update>
      <Where ActionId="ToggleTechTree" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_T</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="RangedAttack" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_R</GestureData>
      </Set>
    </Update>
    <!-- 0.5.2 patch: rebind PrevCity / NextCity off bare [ / ] to
         Shift+[ / Shift+] so the notifications-center cycle (bare
         [/], high-frequency) gets the more ergonomic binding and city
         jump (low-frequency) gets the Shift modifier. Same
         steal-and-rebind pattern as Q/E/A/Z/C → Alt+letter. Shift+ on
         brackets was confirmed firing via the slurp/burp test
         (commit ceede88, Noel test 2026-05-25). -->
    <Update>
      <Where ActionId="PrevCity" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_LBRACKET</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="NextCity" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_RBRACKET</GestureData>
      </Set>
    </Update>
  </InputActionDefaultGestures>

  <!-- Bug #25b round 6 2026-05-24: Reverted the Delete approach from
       round 5 — Database.log showed "ERROR executing the delete
       statement" which also prevented our cycle gesture rows from
       registering (id=98/99 stopped firing entirely). Confirmed via
       Noel JAWS+NVDA test: dual-screen-reader silence means the audio
       loss isn't a screen-reader-specific quirk. It's something
       deeper in our CAMM / Tolk pipeline. Need to debug downstream
       rather than keep fighting bindings. For now: cycle stays bound
       to Ctrl+./, sharing the gesture with engine Civilopedia. Both
       fire; cycle speech reaches Lua.log (verified) but doesn't
       reach the user's audio. CAMM-side instrumentation is next. -->

  <!-- ===================================================================
       Part 2: register new CivViAccess engine actions
       =================================================================== -->
  <InputActions>
    <Row ActionId="CIVVIACCESS_CursorNW"
         Name="LOC_CIVVIACCESS_HOTKEY_CURSOR_NW"
         Description="LOC_CIVVIACCESS_HOTKEY_CURSOR_NW_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
