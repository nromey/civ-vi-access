         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_PERIOD"/>
    <Row ActionId="CIVVIACCESS_PrevUnitAll" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_COMMA"/>
