         (CHOOSE_TECH from notification center) is the canonical
         entry; Alt+T is the direct-open shortcut. T is bare-key
         engine-bound; Alt+T mirrors Alt+P's safe shape. -->
    <Row ActionId="CIVVIACCESS_OpenTechPicker"
         Name="LOC_CIVVIACCESS_HOTKEY_OPEN_TECH_PICKER"
         Description="LOC_CIVVIACCESS_HOTKEY_OPEN_TECH_PICKER_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
