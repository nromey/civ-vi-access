    <Row ActionId="CIVVIACCESS_UnblockProduction" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_P"/>
    <!-- 0.5.2: notifications center cycle on bare [ / ]. Civ V Access
         parity (CivVAccess_MessageBuffer uses bare [/]). Initial 0.5.2
         shipped Ctrl+[/] but Civ VI's gesture parser silently strips
         the Ctrl modifier on bracket keys (confirmed Noel test
         2026-05-25 — Ctrl+[/] inert, bare [/] cycled). Owning the
         bare binding explicitly + rebinding PrevCity / NextCity to
         Alt+[/]+ in Part 1 above. Same steal-and-rebind pattern as
