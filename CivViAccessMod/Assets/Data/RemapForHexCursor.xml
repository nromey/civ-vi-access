         Description="LOC_CIVVIACCESS_HOTKEY_RECENTER_ON_UNIT_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- Mod-wide "say again": re-speak the last announcement (Ctrl+T). Works
         over vanilla DLC reveal popups too — engine actions fire while those
         PopupPriority.Low popups are up (that's how Escape reached the pause
         menu). Cross-VM last-spoken is tracked in HexCursorAddin via the
         CivViAccess_SpeechEmitted event. Base reveal popups consume bare-T /
         Ctrl+T in their own raw handler first, so no double-read there. -->
    <Row ActionId="CIVVIACCESS_RepeatAnnounce"
         Name="LOC_CIVVIACCESS_HOTKEY_REPEAT_ANNOUNCE"
         Description="LOC_CIVVIACCESS_HOTKEY_REPEAT_ANNOUNCE_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- Shift+I: read the full (long) visual description of the last reveal
         popup (hero / secret society). The short description is spoken inline
         in the announce; this is the deferred "Press I" long description,
         delivered via an engine action since the listener can't own the
         vanilla popup's input. Cinematic reveals have no long desc. -->
    <Row ActionId="CIVVIACCESS_RevealLongDesc"
         Name="LOC_CIVVIACCESS_HOTKEY_REVEAL_LONG_DESC"
         Description="LOC_CIVVIACCESS_HOTKEY_REVEAL_LONG_DESC_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- Cycle ALL units (ignores ready-to-select filter). Engine's
         . / , skip units that already have orders; once all units have
         moved, both go silent. Ctrl+. / Ctrl+, walk the full unit list.
         Civ V Access parity (CivVAccess_UnitControlSelection.cycleAllUnits). -->
    <Row ActionId="CIVVIACCESS_NextUnitAll"
         Name="LOC_CIVVIACCESS_HOTKEY_NEXT_UNIT_ALL"
         Description="LOC_CIVVIACCESS_HOTKEY_NEXT_UNIT_ALL_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_PrevUnitAll"
