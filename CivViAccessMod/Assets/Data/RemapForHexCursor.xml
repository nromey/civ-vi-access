         Description="LOC_CIVVIACCESS_HOTKEY_NOTIFICATION_NEXT_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_NotificationReminderToggle"
