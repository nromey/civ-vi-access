<?xml version="1.0" encoding="utf-8"?>
<!--
  Two-part XML driving CivViAccess's input layer:

  1. Move existing Civ VI engine actions OFF Q/E/A/Z/C to Alt+letter. Frees
     the bare letters for HexCursor. Sighted muscle memory preserved — same
     letter, hold Alt.

       Q  ToggleResources    -> Alt+Q
       E  AutoExplore        -> Alt+E
       A  Attack             -> Alt+A
       Z  Sleep              -> Alt+Z
       C  ToggleCivicsTree   -> Alt+C

  2. Register NEW engine actions (CIVVIACCESS_Cursor*) for HexCursor and
     coord keys. Bind each to its primary key + numpad alternate where
     applicable. Pressing one fires Events.InputActionTriggered with that
     action's ID; HexCursorAddin.lua subscribes and dispatches. This is
     the route used by the engine itself for ALL hotkeys; AddUserInterfaces
     Contexts don't get raw keyboard (confirmed empirically).

  Why this is acceptable per [[feedback-runtime-toggle-over-install-choice]]:
  the rebind is consistent (same letter + Alt modifier), discoverable (in
  the ? help overlay), reversible (user can remap via Civ VI Options >
  Keybindings).

  Numpad alternates were dropped 0.5.0. Two unfixable conflicts:
  NVDA's default "Use numpad keys for object navigation" intercepts
  the numpad before Civ VI sees it, AND Alt+numpad on Windows is the
  Unicode-input gesture (Alt+0233 = é etc.) which collides with the
  Alt+QAZEDC move bindings. Civ V Access and other accessibility mods
  converged on letter-cluster-only nav for these same reasons; we're
  catching up. Letter keys (Q/E/A/D/Z/C) are the only nav surface.

  Two-modifier letter cluster (0.5.0, revised after test failure):

    Bare        Q/E/A/D/Z/C   → HexCursor move (read terrain, don't commit)
    Shift+      Shift+QAZEDC  → Unit direct-move (commit a move)
    Alt+letter  Alt+QAZEDC    → Engine actions (ToggleResources etc.)

  Originally tried Alt+letter for Move + Ctrl+Alt+letter for the engine
  actions, but the 3-key Update statement for the engine rebind silently
  failed in test — Civ VI's vanilla InputConfiguration.xml never uses
  3-key combos and the gesture parser doesn't appear to support them.
  Result: engine actions stayed on Alt+letter (from 0.4.x), our Move
  bindings on Alt+letter collided silently, and no movement fired. Shift+
  letter avoids the conflict entirely AND isn't intercepted by NVDA/JAWS
  (Shift is a typing modifier, not screen-reader-claimed).
-->
<GameInfo>
  <!-- ===================================================================
       Part 1: rebind engine actions off bare letters (frees Q/E/A/Z/C
       for HexCursor cursor pan). Engine actions land on Alt+letter, same
       as the 0.4.x state. Our Move bindings live on Shift+letter (no
       collision).
       =================================================================== -->
  <InputActionDefaultGestures>
    <Update>
      <Where ActionId="ToggleResources" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_Q</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="AutoExplore" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_E</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="Attack" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_A</GestureData>
      </Set>
    </Update>
    <!-- Sleep on Alt+Z. Slurp/burp diagnostic 2026-05-25 confirmed
         Alt+Z fires actions ("alt z fires" heard). Earlier Sleep
         silence was likely a unit-not-selected case (Sleep has
         CategoryId="UNIT" in engine XML, only fires with a unit
         actively selected). Test with a unit selected to confirm. -->
    <Update>
      <Where ActionId="Sleep" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_Z</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="ToggleCivicsTree" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_C</GestureData>
      </Set>
    </Update>
    <!-- T and R don't collide with the move bindings; keeping them on
         Alt+letter (set in 0.4.1) for now. Briefing re-read actions
         (CIVVIACCESS_AbilitiesReread on T, CIVVIACCESS_PortraitDescribe
         on I, CIVVIACCESS_DawnOfManTranscript on S, CIVVIACCESS_Repeat
         Briefing on R) use the bare letters, registered below. -->
    <Update>
      <Where ActionId="ToggleTechTree" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_T</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="RangedAttack" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_R</GestureData>
      </Set>
    </Update>
    <!-- 0.5.2 patch: rebind PrevCity / NextCity off bare [ / ] to
         Shift+[ / Shift+] so the notifications-center cycle (bare
         [/], high-frequency) gets the more ergonomic binding and city
         jump (low-frequency) gets the Shift modifier. Same
         steal-and-rebind pattern as Q/E/A/Z/C → Alt+letter. Shift+ on
         brackets was confirmed firing via the slurp/burp test
         (commit ceede88, Noel test 2026-05-25). -->
    <Update>
      <Where ActionId="PrevCity" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_LBRACKET</GestureData>
      </Set>
    </Update>
    <Update>
      <Where ActionId="NextCity" Index="0" GestureType="KBMouse"/>
      <Set>
        <GestureData>LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_RBRACKET</GestureData>
      </Set>
    </Update>
  </InputActionDefaultGestures>

  <!-- Bug #25b round 6 2026-05-24: Reverted the Delete approach from
       round 5 — Database.log showed "ERROR executing the delete
       statement" which also prevented our cycle gesture rows from
       registering (id=98/99 stopped firing entirely). Confirmed via
       Noel JAWS+NVDA test: dual-screen-reader silence means the audio
       loss isn't a screen-reader-specific quirk. It's something
       deeper in our CAMM / Tolk pipeline. Need to debug downstream
       rather than keep fighting bindings. For now: cycle stays bound
       to Ctrl+./, sharing the gesture with engine Civilopedia. Both
       fire; cycle speech reaches Lua.log (verified) but doesn't
       reach the user's audio. CAMM-side instrumentation is next. -->

  <!-- ===================================================================
       Part 2: register new CivViAccess engine actions
       =================================================================== -->
  <InputActions>
    <Row ActionId="CIVVIACCESS_CursorNW"
         Name="LOC_CIVVIACCESS_HOTKEY_CURSOR_NW"
         Description="LOC_CIVVIACCESS_HOTKEY_CURSOR_NW_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_CursorNE"
         Name="LOC_CIVVIACCESS_HOTKEY_CURSOR_NE"
         Description="LOC_CIVVIACCESS_HOTKEY_CURSOR_NE_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_CursorW"
         Name="LOC_CIVVIACCESS_HOTKEY_CURSOR_W"
         Description="LOC_CIVVIACCESS_HOTKEY_CURSOR_W_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_CursorE"
         Name="LOC_CIVVIACCESS_HOTKEY_CURSOR_E"
         Description="LOC_CIVVIACCESS_HOTKEY_CURSOR_E_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_CursorSW"
         Name="LOC_CIVVIACCESS_HOTKEY_CURSOR_SW"
         Description="LOC_CIVVIACCESS_HOTKEY_CURSOR_SW_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_CursorSE"
         Name="LOC_CIVVIACCESS_HOTKEY_CURSOR_SE"
         Description="LOC_CIVVIACCESS_HOTKEY_CURSOR_SE_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_WhereAmI"
         Name="LOC_CIVVIACCESS_HOTKEY_WHERE_AM_I"
         Description="LOC_CIVVIACCESS_HOTKEY_WHERE_AM_I_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_WhereAmIAbs"
         Name="LOC_CIVVIACCESS_HOTKEY_WHERE_AM_I_ABS"
         Description="LOC_CIVVIACCESS_HOTKEY_WHERE_AM_I_ABS_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_OpenHelp"
         Name="LOC_CIVVIACCESS_HOTKEY_OPEN_HELP"
         Description="LOC_CIVVIACCESS_HOTKEY_OPEN_HELP_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- 0.5.0: unit direct-move bindings (Alt+QAZEDC). Phase 1 of
         Playable Basics. directMove(direction) selects the head unit,
         resolves the adjacent plot, and issues MoveUnitToPlot via
         the engine's own Civ6Common helper. World-context only — the
         actions are nonsensical outside the in-game map. -->
    <Row ActionId="CIVVIACCESS_MoveNW"
         Name="LOC_CIVVIACCESS_HOTKEY_MOVE_NW"
         Description="LOC_CIVVIACCESS_HOTKEY_MOVE_NW_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_MoveNE"
         Name="LOC_CIVVIACCESS_HOTKEY_MOVE_NE"
         Description="LOC_CIVVIACCESS_HOTKEY_MOVE_NE_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_MoveW"
         Name="LOC_CIVVIACCESS_HOTKEY_MOVE_W"
         Description="LOC_CIVVIACCESS_HOTKEY_MOVE_W_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_MoveE"
         Name="LOC_CIVVIACCESS_HOTKEY_MOVE_E"
         Description="LOC_CIVVIACCESS_HOTKEY_MOVE_E_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_MoveSW"
         Name="LOC_CIVVIACCESS_HOTKEY_MOVE_SW"
         Description="LOC_CIVVIACCESS_HOTKEY_MOVE_SW_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_MoveSE"
         Name="LOC_CIVVIACCESS_HOTKEY_MOVE_SE"
         Description="LOC_CIVVIACCESS_HOTKEY_MOVE_SE_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- 0.5.0: unit info readout (bare /) + recenter cursor on unit
         (Ctrl+/). Mirrors Civ V Access's CivVAccess_UnitControlSelection
         bindings (VK_OEM_2 / Ctrl+VK_OEM_2). -->
    <Row ActionId="CIVVIACCESS_UnitInfo"
         Name="LOC_CIVVIACCESS_HOTKEY_UNIT_INFO"
         Description="LOC_CIVVIACCESS_HOTKEY_UNIT_INFO_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_RecenterOnUnit"
         Name="LOC_CIVVIACCESS_HOTKEY_RECENTER_ON_UNIT"
         Description="LOC_CIVVIACCESS_HOTKEY_RECENTER_ON_UNIT_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- Cycle ALL units (ignores ready-to-select filter). Engine's
         . / , skip units that already have orders; once all units have
         moved, both go silent. Ctrl+. / Ctrl+, walk the full unit list.
         Civ V Access parity (CivVAccess_UnitControlSelection.cycleAllUnits). -->
    <Row ActionId="CIVVIACCESS_NextUnitAll"
         Name="LOC_CIVVIACCESS_HOTKEY_NEXT_UNIT_ALL"
         Description="LOC_CIVVIACCESS_HOTKEY_NEXT_UNIT_ALL_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_PrevUnitAll"
         Name="LOC_CIVVIACCESS_HOTKEY_PREV_UNIT_ALL"
         Description="LOC_CIVVIACCESS_HOTKEY_PREV_UNIT_ALL_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- 0.5.2: city production unblock (Alt+P). Workaround until the
         full accessible production picker lands. Queues Monument /
         Warrior / cheapest-available into every local-player city with
         an empty production queue. Bare P = engine OnlinePause; Alt+P
         is free. -->
    <Row ActionId="CIVVIACCESS_UnblockProduction"
         Name="LOC_CIVVIACCESS_HOTKEY_UNBLOCK_PRODUCTION"
         Description="LOC_CIVVIACCESS_HOTKEY_UNBLOCK_PRODUCTION_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- 0.5.2: notifications center cycle + reminder toggle. Ctrl+[ /
         Ctrl+] walk prev/next pending notification, sorted by priority
         (blockers first). Alt+N toggles the idle reminder ("N things
         to do" after 20s idle). Bare [ / ] = engine PrevCity/NextCity
         and we deliberately do not steal them — Ctrl+[/] is free. -->
    <Row ActionId="CIVVIACCESS_NotificationPrev"
         Name="LOC_CIVVIACCESS_HOTKEY_NOTIFICATION_PREV"
         Description="LOC_CIVVIACCESS_HOTKEY_NOTIFICATION_PREV_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_NotificationNext"
         Name="LOC_CIVVIACCESS_HOTKEY_NOTIFICATION_NEXT"
         Description="LOC_CIVVIACCESS_HOTKEY_NOTIFICATION_NEXT_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_NotificationReminderToggle"
         Name="LOC_CIVVIACCESS_HOTKEY_NOTIFICATION_REMINDER_TOGGLE"
         Description="LOC_CIVVIACCESS_HOTKEY_NOTIFICATION_REMINDER_TOGGLE_HELP"
         CategoryId="GLOBAL" ContextId="World" LayoutType="PC"/>
    <!-- Round 11: briefing re-read actions. These fire in LoadScreen
         context (and in-game, harmlessly). LoadScreenAccess subscribes
         to Events.InputActionTriggered to dispatch them to the right
         speak* function. -->
    <!-- ContextId="Universal" so these fire in ALL contexts
         including Loading (LoadScreen window) and Shell (main
         menu). Round-13 found World-context-bound actions don't
         dispatch during InputContext.Loading; Universal does. -->
    <Row ActionId="CIVVIACCESS_RepeatBriefing"
         Name="LOC_CIVVIACCESS_HOTKEY_REPEAT_BRIEFING"
         Description="LOC_CIVVIACCESS_HOTKEY_REPEAT_BRIEFING_HELP"
         CategoryId="GLOBAL" ContextId="Universal" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_AbilitiesReread"
         Name="LOC_CIVVIACCESS_HOTKEY_ABILITIES_REREAD"
         Description="LOC_CIVVIACCESS_HOTKEY_ABILITIES_REREAD_HELP"
         CategoryId="GLOBAL" ContextId="Universal" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_PortraitDescribe"
         Name="LOC_CIVVIACCESS_HOTKEY_PORTRAIT_DESCRIBE"
         Description="LOC_CIVVIACCESS_HOTKEY_PORTRAIT_DESCRIBE_HELP"
         CategoryId="GLOBAL" ContextId="Universal" LayoutType="PC"/>
    <Row ActionId="CIVVIACCESS_DawnOfManTranscript"
         Name="LOC_CIVVIACCESS_HOTKEY_DAWN_OF_MAN_TRANSCRIPT"
         Description="LOC_CIVVIACCESS_HOTKEY_DAWN_OF_MAN_TRANSCRIPT_HELP"
         CategoryId="GLOBAL" ContextId="Universal" LayoutType="PC"/>
  </InputActions>

  <!-- ===================================================================
       Part 3: default key bindings for the new actions.
       Letter-only: numpad alternates dropped 0.5.0 — see top-of-file
       comment for rationale.
       =================================================================== -->
  <InputActionDefaultGestures>
    <Row ActionId="CIVVIACCESS_CursorNW" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_Q"/>
    <Row ActionId="CIVVIACCESS_CursorNE" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_E"/>
    <Row ActionId="CIVVIACCESS_CursorW" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_A"/>
    <Row ActionId="CIVVIACCESS_CursorE" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_D"/>
    <Row ActionId="CIVVIACCESS_CursorSW" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_Z"/>
    <Row ActionId="CIVVIACCESS_CursorSE" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_C"/>
    <!-- Where-am-I (capital-relative): Shift+S -->
    <Row ActionId="CIVVIACCESS_WhereAmI" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_S"/>
    <!-- Where-am-I absolute: Alt+S -->
    <Row ActionId="CIVVIACCESS_WhereAmIAbs" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_S"/>
    <!-- ? help: Shift+/ -->
    <Row ActionId="CIVVIACCESS_OpenHelp" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_SLASH"/>
    <!-- 0.5.0: unit move bindings on Shift+letter. Mirrors the cursor's
         bare-letter layout — same hex shape, hold Shift to move the unit
         instead of just the cursor. Shift avoids collision with the
         engine-action rebinds on Alt+letter (ToggleResources etc.) and
         isn't intercepted by NVDA/JAWS the way Alt+numpad would be. -->
    <Row ActionId="CIVVIACCESS_MoveNW" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_Q"/>
    <Row ActionId="CIVVIACCESS_MoveNE" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_E"/>
    <Row ActionId="CIVVIACCESS_MoveW" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_A"/>
    <Row ActionId="CIVVIACCESS_MoveE" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_D"/>
    <Row ActionId="CIVVIACCESS_MoveSW" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_Z"/>
    <Row ActionId="CIVVIACCESS_MoveSE" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_C"/>
    <!-- Unit info: bare / for the readout, Ctrl+/ for recenter on
         selected unit. Mnemonic: / is the help/info key, matches Civ V
         Access. Shift+/ is already taken by CIVVIACCESS_OpenHelp. -->
    <Row ActionId="CIVVIACCESS_UnitInfo" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SLASH"/>
    <Row ActionId="CIVVIACCESS_RecenterOnUnit" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_CTRL+LOC_OPTIONS_KEY_SLASH"/>
    <!-- Cycle-all bindings: Shift+. for next-all, Shift+, for prev-all.
         Round 8 mnemonic 2026-05-24: paired with the engine's bare
         period/comma (NextUnit/PrevUnit). Bare = "next unit needing
         orders" (engine's ready-to-select gate). Shift = "include
         all units regardless of orders state" (our cycle-all
         override). Same key family, direction matches engine's
         (period=forward, comma=back). Both Shift+./, are unbound in
         vanilla InputConfiguration.xml — no engine collision.
         Previously bare N / Shift+N (round 7); changed once the
         Shift+./, free-gesture check confirmed the better mnemonic.
         See [[reference_engine_action_dual_dispatch_breaks_audio]]
         for why we avoided Ctrl+./,. -->
    <Row ActionId="CIVVIACCESS_NextUnitAll" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_PERIOD"/>
    <Row ActionId="CIVVIACCESS_PrevUnitAll" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_SHIFT+LOC_OPTIONS_KEY_COMMA"/>
    <!-- 0.5.2: unblock production hotkey on Alt+P. P (OnlinePause) is
         bound bare; Alt+P is free. -->
    <Row ActionId="CIVVIACCESS_UnblockProduction" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_P"/>
    <!-- 0.5.2: notifications center cycle on bare [ / ]. Civ V Access
         parity (CivVAccess_MessageBuffer uses bare [/]). Initial 0.5.2
         shipped Ctrl+[/] but Civ VI's gesture parser silently strips
         the Ctrl modifier on bracket keys (confirmed Noel test
         2026-05-25 — Ctrl+[/] inert, bare [/] cycled). Owning the
         bare binding explicitly + rebinding PrevCity / NextCity to
         Alt+[/]+ in Part 1 above. Same steal-and-rebind pattern as
         Q/E/A/Z/C → Alt+letter for HexCursor. Reminder toggle on
         Alt+N (N is unbound in engine). -->
    <Row ActionId="CIVVIACCESS_NotificationPrev" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_LBRACKET"/>
    <Row ActionId="CIVVIACCESS_NotificationNext" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_RBRACKET"/>
    <Row ActionId="CIVVIACCESS_NotificationReminderToggle" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_ALT+LOC_OPTIONS_KEY_N"/>
    <!-- Round 11: briefing re-read keys. R = repeat full briefing,
         T = abilities only, I = portrait description, S = Dawn of
         Man transcript. Mnemonic: R=Repeat, T=Traits, I=Image,
         S=Sean. -->
    <Row ActionId="CIVVIACCESS_RepeatBriefing" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_R"/>
    <Row ActionId="CIVVIACCESS_AbilitiesReread" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_T"/>
    <Row ActionId="CIVVIACCESS_PortraitDescribe" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_I"/>
    <Row ActionId="CIVVIACCESS_DawnOfManTranscript" Index="0" GestureType="KBMouse"
         GestureData="LOC_OPTIONS_KEY_S"/>
  </InputActionDefaultGestures>
</GameInfo>
