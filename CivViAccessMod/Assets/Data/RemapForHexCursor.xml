         bound Sleep on Z, but in Civ VI Z is our CursorSW. Alt+Z
         catches the user-with-Civ-V-muscle-memory case: civilians
         actually sleep; military gets an educational redirect to R
         ("Cannot sleep Warrior. Press R to fortify instead."). -->
    <Row ActionId="CIVVIACCESS_Sleep"
         Name="LOC_CIVVIACCESS_HOTKEY_SLEEP"
         Description="LOC_CIVVIACCESS_HOTKEY_SLEEP_HELP"
         CategoryId="UNIT" ContextId="World" LayoutType="PC"/>
    <!-- 0.5.1 Stage-1 production picker open hotkey. Temporary —
         Stage 2 wires picker open via notification activation (the
