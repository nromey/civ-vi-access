        </Row>
        <Row Tag="LOC_CIVVIACCESS_NOTIFICATION_TITLE">
            <Text>Notification.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_CHOICE_FORMAT">
            <Text>Choose: option {1_N} of {2_M}, {3_Text}. Use Left or Right to switch options, Enter to confirm.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_FOCUS_FORMAT">
            <Text>Option {1_N} of {2_M}: {3_Text}.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_CHOICE_REQUIRED">
            <Text>This choice is required. Press Left or Right to switch options, Enter to confirm.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_SINGLE_BUTTON_FORMAT">
