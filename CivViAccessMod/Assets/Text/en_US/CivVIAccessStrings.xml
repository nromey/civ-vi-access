        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_DISMISS_HINT">
            <Text>Press Enter or Escape to dismiss.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_PORTRAIT_AND_REREAD_HINT">
            <Text>Press Control plus I for advisor description. Press Control plus T to re-read.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_REREAD_HINT">
            <Text>Press Control plus T to re-read.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_PORTRAIT_PLACEHOLDER">
            <Text>Advisor portrait description not yet available.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_NO_PORTRAIT">
            <Text>No portrait shown.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_ADVISOR_ACTIVATED_FORMAT">
            <Text>{1_Choice} chosen.</Text>
        </Row>

        <!-- Expansion intro popup (waypoint 05). R&F + GS welcome
             slideshow nav + announce lives in
             ExpansionIntroAccess.lua. -->
        <Row Tag="LOC_CIVVIACCESS_EXPANSION_INTRO_WELCOME_RF">
            <Text>Welcome to Rise and Fall.</Text>
        </Row>
        <Row Tag="LOC_CIVVIACCESS_EXPANSION_INTRO_WELCOME_GS">
            <Text>Welcome to Gathering Storm.</Text>
        </Row>
