<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows (not plain net10.0) so Microsoft.Win32.Registry,
         WindowsIdentity, and the other Windows-only APIs we now depend on
         are available in-framework without separate packages. The launcher
         is Windows-only by definition: Tolk, AttachThreadInput, IFEO
         redirect, registry — none have a Linux/macOS equivalent. The Mac
         stretch goal will need its own native helper (see
         [[project-cross-platform]]). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 0.3.0 = CAMM-consumer milestone. As of this version Civ VI
         Access is built on the CAMM framework (github.com/nromey/camm,
         pinned via the /camm/ submodule) rather than carrying its own
         copies of the launcher/wizard/installer code. Reservations:
         0.2.0 = install wizard rewrite, 0.3.0 = CAMM consumption. The
         release workflow overrides this via -p:Version=<tag> at
         publish time. This default is what local dotnet build /
         dotnet publish produce in dev. -->
    <Version>0.6.0</Version>

    <!-- Distributed exe name has no dots, all camelCase. The project
         folder + namespace can keep their existing "CivVIAccess.Launcher"
         shape; only the produced binary is what users see. -->
    <AssemblyName>CivViAccess</AssemblyName>
    <Product>Civ VI Access</Product>
    <AssemblyTitle>Civ VI Access Launcher</AssemblyTitle>
    <Company>Noel Romey</Company>
    <!-- LibraryImport's source generator emits unsafe pointer code for
         marshalling. Required for the AOT-clean P/Invokes in
         WindowFocusManager.cs. Does not weaken user code — only permits
         the generated stubs to compile. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Native AOT deployment. `dotnet publish -c Release -r win-x64`
         produces a single self-contained native .exe with no .NET runtime
         install requirement. Decided over self-contained framework-
         dependent in 2026-05 (see project_launcher_publish_mode memory):
         smaller footprint (~10-20 MB vs ~70-100 MB), faster cold start,
         one-file deploy. The launcher is a pure P/Invoke catapult — no
         reflection, no dynamic loading, no serializer attribute scanning
         — which makes it textbook AOT territory.
         InvariantGlobalization drops ICU + culture data we never use
         (the launcher only handles ASCII paths and log markers). -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- WinForms is enabled for the install wizard (see WIZARD_PLAN.md
         and CivViAccess\Wizard\). The plain TaskDialog/MessageBox UI in
         Dialogs.cs is kept for non-wizard one-shot prompts. AOT-clean
         in .NET 10 with this property set; expect exe size to grow
         from ~7.5 MB to ~13-15 MB once wizard ships. We keep
         <OutputType>Exe</OutputType> (above) rather than the WinExe
         default that UseWindowsForms otherwise implies — the launcher
         needs its console window for log output and as the dialog
         owner HWND (see Dialogs.cs). -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- WinForms triggers NETSDK1175 ("not supported or recommended
         with trimming enabled") under PublishAot, because trimming
         can prune reflection-discovered types in the broader WinForms
         surface (Designer-serialized controls, data binding, the
         property grid). Our wizard surface is intentionally code-only
         (no Designer files, no data binding, no property grid, no
         reflection-driven serialization), so we acknowledge the
         warning and proceed. Any trimming-induced breakage will show
         up during wizard testing; revisit if it does. -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>

    <!-- App manifest declares Common Controls v6 dependency, required
         for TaskDialogIndirect (used by Dialogs.ShowChoice for command-
         link choice dialogs). Without this, TaskDialogIndirect throws
         EntryPointNotFoundException at runtime because comctl32 v5
         (the default) doesn't export it. Also sets DPI awareness so
         dialogs render crisply on high-DPI displays. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    CAMM is a git submodule at /camm/, pinned to a specific tag (see
    .gitmodules + commit SHA). The framework code (Logger, SemVer,
    ProcessLauncher, TolkBootstrap, Dialogs) lives there as of 0.0.1;
    we consume it via ProjectReference rather than NuGet (see
    CAMM_EXTRACTION_PLAN.md for the rationale — single-maintainer
    low-overhead workflow with version pinning via submodule SHA).

    Tolk's vendored C# binding also lives in CAMM and is exposed via
    its <Compile Include> there — no need to re-include here.
  -->
  <ItemGroup>
    <ProjectReference Include="..\camm\Camm\Camm.csproj" />
  </ItemGroup>

  <!--
    Report window. The mod streams HTML reports over the CAMM log-tail
    bridge (the #SHOWREPORT marker, handled in Report\ReportBridge.cs);
    Report\ReportWindow.cs writes the assembled page to a file and opens
    it in an isolated Microsoft Edge app-mode window (the "app" launch
    flag), so the screen reader's browse-mode handles all the heading /
    list / table / link navigation for free (and future civilopedia
    hyperlinks).

    NO WebView2 PackageReference: the in-process WebView2 control was
    abandoned 2026-06-02 because it cannot activate under Native AOT.
    WebView2's RCW-based COM activation needs built-in COM interop, which
    AOT disables — CoreWebView2Environment.CreateAsync throws
    NotSupportedException ("Built-in COM has been disabled via a feature
    switch") at runtime even though ILC compiles the assembly. Known,
    unresolved WebView2+NativeAOT gap (WebView2Feedback #4783 / #4800).
    Driving the user's already-installed Edge keeps the launcher AOT, adds
    zero NuGet/native deps, and needs no WebView2Loader.dll extraction.
    Edge is present by default on Win10 20H2+/Win11; ReportWindow falls
    back to the OS default browser if it can't be found.
  -->

  <!--
    Tolk DLLs are embedded as resources (logical name `tolk/<filename>`)
    so the launcher exe is genuinely standalone — drop the .exe anywhere
    and Camm.TolkBootstrap extracts the sidecars next to it on first
    run. This unlocks the "download a single file, double-click to
    install" UX. Native AOT compiles them in as binary blobs.

    The DLL source lives in CAMM at camm/third_party/tolk/dist/x64/
    (so all CAMM consumers share one vendored copy). CAMM's library
    deliberately does NOT embed these resources — the consuming exe
    must, so TolkBootstrap reading from Assembly.GetEntryAssembly()
    finds them.

    All DLLs in this directory are x64 — folder name enforces it
    and the launcher's <PlatformTarget>x64</PlatformTarget> would
    refuse to load a 32-bit DLL anyway.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\camm\third_party\tolk\dist\x64\*.dll">
      <LogicalName>tolk/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The mod source tree is embedded as resources (logical name
    `mod/<relative path>`) so the installer can extract it into Civ VI's
    DLC dir on install without needing an external mod download. Mod
    folder is ~640 KB, AOT-compiled into the .exe as binary blobs.

    Skip ModBuddy-managed bin/obj if they ever appear in CivViAccessMod;
    only Lua and XML source files need to ship.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\CivViAccessMod\**\*.*"
                      Exclude="..\CivViAccessMod\bin\**\*;..\CivViAccessMod\obj\**\*">
      <LogicalName>mod/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
